{
  "name": "video-ceria",
  "productName": "Video Ceria",
  "version": "1.0.0",
  "description": "Pemutar video anak offline yang ramah anak",
  "main": "main.js",
  "author": "Video Ceria",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.videoceria.app",
    "productName": "Video Ceria",
    "directories": { "output": "dist" },
    "files": ["main.js", "index.html", "styles.css", "renderer.js", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Ceria"
    }
  }
}
